{
  "name": "AIDD-MS-0 — SQL Foundations Lab",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  // sshd enables `gh codespace ssh` (CLI smoke tests / support); VS Code itself
  // does not need it.
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  // Self-check on every codespace creation: proves the student login can query
  // AdventureWorksLT. Result is visible in the creation log (gh codespace logs).
  "postCreateCommand": "bash .devcontainer/smoke-test.sh",
  // The MSSQL extension acquires its own .NET runtime (for SqlToolsService) via
  // vscode-dotnet-runtime. In a container that acquisition can deadlock on a
  // socket-based lock (/tmp/vscd-installedLk.sock → EADDRINUSE), so .NET never
  // installs, SqlToolsService never starts, and mssql.runQuery is never
  // registered ("command 'mssql.runQuery' not found"). Disabling the mutex is
  // the runtime's documented fix for this.
  "remoteEnv": {
    "VSCODE_DOTNET_RUNTIME_DISABLE_MUTEX": "true"
  },
  "customizations": {
    "vscode": {
      // The MSSQL extension is the query client (Azure Data Studio is retired).
      // The pre-seeded connection profile lives in .vscode/settings.json (workspace
      // scope) — NOT here. Dev-container customizations land in machine-scoped
      // settings, where the MSSQL extension does not surface connection profiles
      // (vscode-mssql#17500). Workspace settings are where it reads them.
      "extensions": ["ms-mssql.mssql"]
    }
  },
  // Surface the SQL Server port for tools running in the workspace if needed.
  "forwardPorts": ["mssql:1433"],
  "remoteUser": "vscode"
}
